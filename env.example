# Copy to .env and fill in real values. .env itself is gitignored — never commit it.
# Every value below is a placeholder, not a real secret.

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql://agriguard:agriguard@localhost:5432/agriguard

# --- Object storage (MinIO) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agriguard-uploads

# --- LLM provider for the RAG advisory layer: IBM watsonx.ai / Granite ---
# Get real values from https://dataplatform.cloud.ibm.com/ — never paste
# real values directly into this file if it's tracked; keep secrets in
# your local .env or in Infisical per docs/TECHNICAL-ARCHITECTURE.md.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model naming moves fast — check the current list before setting this:
# https://dataplatform.cloud.ibm.com/docs/content/wsj/analyze-data/fm-api-model-ids.html
GRANITE_MODEL_ID=
